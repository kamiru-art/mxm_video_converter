# Build outputs and dependencies live in the .gitignore of each subproject:
#   rust-core/.gitignore  -> /target
#   web/.gitignore        -> node_modules/, dist/, src/wasm/

# ffmpeg.wasm core (the build generates it from node_modules)
web/public/ffmpeg/

# Coverage reports: they belong to the local test runs and to CI, not here
.coverage
.coverage.*
coverage.xml
htmlcov/

# Python virtual environment left over from the retired desktop application
.venv/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
