{
  "name": "mxm-studio",
  // The account id is deliberately NOT committed. This repository is
  // public, and an account identifier in a public file is a free target
  // for anyone phishing Cloudflare credentials. It is not a secret and it
  // is useless without the API token, but it costs nothing to omit it.
  // CI supplies it as the CLOUDFLARE_ACCOUNT_ID secret; for a local
  // deploy, export CLOUDFLARE_ACCOUNT_ID before running wrangler.
  "compatibility_date": "2026-08-01",
  // The site lives on the MXM Studio account, whose zone is
  // mxmstudio.work. www.mxmstudio.work is not a Worker: a zone Redirect Rule
  // ("www.mxmstudio.work to mxmstudio.work", 301, path and query kept) on a
  // proxied placeholder record (A www 192.0.2.1). No workers.dev or preview
  // address either: one origin, because localStorage and the installed app
  // belong to it.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "mxmstudio.work", "custom_domain": true }]
}
