{
  // Runs on the MXM Studio account, next to the site. Published by hand
  // (npx wrangler@4 deploy from this directory): it never changes.
  "name": "mxm-studio-www",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "www.mxmstudio.work", "custom_domain": true }]
}
